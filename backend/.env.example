# TAMU System AI Chat (recommended for this project)
TAMUS_AI_CHAT_API_KEY=
TAMUS_AI_CHAT_API_ENDPOINT=https://chat-api.tamu.ai
TAMUS_CHAT_MODEL=protected.gpt-4.1-mini
# Optional comma-separated fallbacks are configured in app defaults:
# protected.gpt-4.1-mini, protected.gpt-4o-mini, protected.gemini-2.5-flash
TAMUS_EMBEDDING_MODEL=protected.text-embedding-3-small

# Optional OpenAI fallback (used only when TAMU key is unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
